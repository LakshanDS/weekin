# Copy to .env and adjust. See README for the one-time database bootstrap.
NUXT_DATABASE_URL=postgres://weekly_app:CHANGE_ME@localhost:5432/weekly_reports
NUXT_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# AI assistant (optional, bonus feature) — any OpenAI-compatible API.
# Leave NUXT_AI_API_KEY empty to run the assistant in offline summary mode.
NUXT_AI_API_KEY=
NUXT_AI_BASE_URL=https://api.openai.com/v1
NUXT_AI_MODEL=gpt-4o-mini
