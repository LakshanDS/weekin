// Cloudflare Workers config. Nitro merges this into the generated wrangler
// config when building with the cloudflare_module preset.
// Local check:  bun run build:cf && bunx wrangler dev
// Deploy:       bunx wrangler deploy   (after `wrangler login`)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekin",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_JWT_SECRET": "set-me-in-dashboard-or-secret",
    "NUXT_AI_API_KEY": "",
    "NUXT_AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "NUXT_AI_MODEL": "gemini-3.5-flash-lite"
  }
  // NUXT_DATABASE_URL should be a secret (real deploy):
  //   bunx wrangler secret put NUXT_DATABASE_URL
  // Optional speed-up later: a Hyperdrive binding in front of the same Postgres.
}
