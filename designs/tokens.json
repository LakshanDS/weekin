{
  "$description": "WeekIn design tokens — source of truth for brand colors, type, spacing, and shapes. Consumed by the app theme (Tailwind @theme) and any future design work.",
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "#242424", "$description": "Primary black. Text, wordmark, dark surfaces, primary buttons." },
      "coral": { "$type": "color", "$value": "#FF5757", "$description": "Brand accent. 'In' of the wordmark, key highlights, active states, brand moments." },
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "App background, cards, reversed logo color." }
    },
    "ink": {
      "soft": { "$type": "color", "$value": "#565656", "$description": "Secondary text on light surfaces (ink 60% mix)." },
      "muted": { "$type": "color", "$value": "#8A8A8A", "$description": "Placeholders, captions, disabled text." },
      "subtle": { "$type": "color", "$value": "#E8E8E8", "$description": "Hairline borders and dividers on white." },
      "tint": { "$type": "color", "$value": "#F5F5F5", "$description": "Subtle filled surfaces, hover washes." }
    },
    "coral": {
      "dark": { "$type": "color", "$value": "#E14B4B", "$description": "Hover/pressed state for coral fills." },
      "tint": { "$type": "color", "$value": "#FFF0F0", "$description": "Coral wash for selected rows, badges, focus glows." }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#1F8A5A", "$description": "Approved status, positive deltas." },
      "info": { "$type": "color", "$value": "#2F6FDE", "$description": "Submitted status, informational charts." },
      "warning": { "$type": "color", "$value": "#D97E00", "$description": "Needs-correction status, overdue flags." },
      "neutral": { "$type": "color", "$value": "#93A1AD", "$description": "Draft status, inactive series." }
    }
  },
  "font": {
    "brand": {
      "family": { "$value": "Fredoka", "$description": "Wordmark + display headings (Google Fonts, weights 500-700, SemiBold 600 for the logo)." },
      "weights": { "$value": "500, 600, 700" }
    },
    "body": {
      "family": { "$value": "Public Sans", "$description": "UI text and forms. Neutral so Fredoka carries the personality." },
      "weights": { "$value": "400, 500, 600" }
    },
    "mono": {
      "family": { "$value": "IBM Plex Mono", "$description": "Eyebrows, labels, statuses, data, timestamps." },
      "weights": { "$value": "400, 500" }
    },
    "scale": {
      "display": { "$value": "40/44 Fredoka 700" },
      "h1": { "$value": "30/36 Fredoka 600" },
      "h2": { "$value": "20/28 Fredoka 600" },
      "body": { "$value": "15/24 Public Sans 400" },
      "small": { "$value": "13/20 Public Sans 400" },
      "label": { "$value": "11/16 IBM Plex Mono 500, uppercase, +0.15em tracking" }
    }
  },
  "space": {
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" }
  },
  "radius": {
    "sm": { "$value": "6px", "$description": "Inputs, small badges." },
    "md": { "$value": "10px", "$description": "Buttons, cards inner." },
    "lg": { "$value": "16px", "$description": "Cards, panels, modals." },
    "pill": { "$value": "999px", "$description": "Status tags, chips, the AI bubble." }
  },
  "shadow": {
    "card": { "$value": "0 1px 2px rgba(36,36,36,0.06)" },
    "float": { "$value": "0 12px 32px rgba(36,36,36,0.18)", "$description": "Chat widget, modals." }
  }
}
