{
  "name": "SF-Assignment",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "bun server/database/seed.demo.ts",
    "db:seed:prod": "bun server/database/seed.prod.ts",
    "test": "vitest run",
    "build:cf": "NITRO_PRESET=cloudflare_module nuxt build",
    "dev:cf": "bun scripts/sync-dev-vars.mjs && bunx wrangler dev --port 8787",
    "deploy": "NITRO_PRESET=cloudflare_module nuxt build && bunx wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.11",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
